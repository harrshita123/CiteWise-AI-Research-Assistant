# Google Cloud OAuth 2.0 web client ID. This value is public, but belongs in local configuration.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Use a local MongoDB instance or your MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=citewise

# Generate a unique value with at least 32 characters. Never commit the real value.
JWT_SECRET=replace-this-with-a-long-random-secret

# Comma-separated frontend origins allowed to send cookies to this API.
ALLOWED_ORIGINS=http://localhost:5173

# Keep false locally. Set true when the API is served through HTTPS in production.
SESSION_COOKIE_SECURE=false

# PDF milestone limits. Storage defaults to backend/storage, relative to the code.
MAX_PDF_SIZE_MB=25
MAX_PDF_PAGES=300
MAX_PDF_CHARACTERS=2000000
EMBEDDING_BATCH_SIZE=32
# Optional absolute path for PDFs, ChromaDB, and the downloaded local model:
# STORAGE_DIRECTORY=/absolute/path/to/citewise-storage
