PYTHON_VERSION=3.13.15
CITEWISE_DEMO_MODE=true
CITEWISE_DEMO_DATABASE=citewise_demo_mentor
# Add both secrets directly in Render. Generate a unique signing secret.
CITEWISE_DEMO_MONGODB_URI=
CITEWISE_DEMO_JWT_SECRET=
SESSION_COOKIE_SECURE=true
ALLOWED_ORIGINS=https://replace-with-demo-project.vercel.app
# For a persistent disk mounted at /var/data, use /var/data/citewise-demo instead.
STORAGE_DIRECTORY=/tmp/citewise-demo
