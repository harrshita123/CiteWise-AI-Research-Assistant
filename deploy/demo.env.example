CITEWISE_DEMO_MODE=true
CITEWISE_DEMO_MONGODB_URI=mongodb://127.0.0.1:27017
CITEWISE_DEMO_DATABASE=citewise_demo_mentor
# Generate a fresh value with openssl rand -hex 32 before starting.
CITEWISE_DEMO_JWT_SECRET=
