[Unit]
Description=CiteWise API
After=network-online.target
Wants=network-online.target

[Service]
User=citewise
Group=citewise
WorkingDirectory=/opt/citewise/backend
EnvironmentFile=/etc/citewise/backend.env
ExecStart=/opt/citewise/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
